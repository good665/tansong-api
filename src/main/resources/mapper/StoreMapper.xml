<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "mybatis-3-mapper.dtd"> <!-- 👈 외부 인터넷 주소 대신 내장 DTD 파일명을 직접 지정합니다 -->

<mapper namespace="kr.tansong.demo.store.mapper.StoreMapper">

    <select id="findAll"
            resultType="kr.tansong.demo.store.dto.StoreResponse">
        SELECT id, name, category, address, description
        FROM stores
        ORDER BY id DESC
    </select>
    
</mapper>